{
    "name": "erwane/cakephp-libs",
    "description": "Erwane CakePHP Libs",
    "type": "cakephp-plugin",
    "authors": [
        {
            "name": "Erwane Breton",
            "email": "erwane@phea.fr",
            "homepage": "https://erwane-breton.fr"
        }
    ],
    "support": {
        "issues": "https://github.com/Erwane/cakephp-libs/issues"
    },
    "minimum-stability": "stable",
    "require": {
        "php": "^7.4 || ^8.0",
        "cakephp/cakephp": "^4.4"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer" : "^4.0",
        "php-parallel-lint/php-parallel-lint": "^1.2",
        "phpro/grumphp": "^1.0",
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Ecl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ecl\\Test\\": "tests/"
        }
    },
    "scripts": {
        "cscheck": "vendor/bin/phpcs -p src/ tests/",
        "csfix": "vendor/bin/phpcbf -p src/ tests/"
    },
    "config": {
        "platform-check": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpro/grumphp": true
        }
    }
}
